{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "kind": {
      "const": "tasks"
    },
    "data": {
      "type": "object",
      "required": [
        "authority",
        "parentDigest",
        "tasks"
      ],
      "properties": {
        "authority": {
          "const": ".agent/control.json"
        },
        "parentDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "shared.schema.json#/$defs/task"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    }
  }
}
