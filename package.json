{
  "name": "pi-gui-mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "prebuild:ios": "expo prebuild --platform ios --no-install",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "export:ios": "expo export --platform ios --output-dir dist/ios --no-bytecode",
    "agent:resume": "node scripts/agent-resume.mjs --remote",
    "agent:validate": "node scripts/agent-validate.mjs",
    "agent:checkpoint": "node scripts/agent-checkpoint.mjs"
  },
  "dependencies": {
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "expo-doctor": "1.21.8",
    "typescript": "~6.0.3"
  }
}
