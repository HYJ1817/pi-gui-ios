{
  "name": "pi-gui-mobile",
  "version": "0.0.1",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "prebuild:ios": "expo prebuild --platform ios --no-install --template expo-template-bare-minimum@58.0.35",
    "typecheck": "tsc --noEmit",
    "check:stack": "node scripts/check-technology-stack.mjs",
    "test": "node --test tests/*.test.mjs && node scripts/check-technology-stack.mjs",
    "export:ios": "expo export --platform ios --output-dir dist/ios --no-bytecode",
    "agent:resume": "node scripts/agent-resume.mjs --remote",
    "agent:validate": "node scripts/agent-validate.mjs",
    "agent:checkpoint": "node scripts/agent-checkpoint.mjs"
  },
  "dependencies": {
    "@react-native-menu/menu": "2.0.0",
    "@react-navigation/elements": "2.9.45",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-linking": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.5.0",
    "react-native-keyboard-controller": "1.23.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.1",
    "tailwindcss": "4.3.3",
    "uniwind": "1.13.2"
  },
  "overrides": {
    "@react-navigation/core": "7.24.0",
    "@react-native/metro-config": "0.88.1"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-gesture-handler",
        "react-native-keyboard-controller",
        "react-native-worklets"
      ]
    }
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "expo-doctor": "1.21.8",
    "typescript": "~6.0.3"
  }
}
