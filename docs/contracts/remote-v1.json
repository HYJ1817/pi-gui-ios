    "path": "/remote/v1/events",
    "scope": "sessions.read",
    "queryParameters": [
      "cursor"
    ],
    "cursorMaxLength": 128,
    "perDeviceBacklog": true,
    "mustFilterByCurrentResourceOwner": true,
    "mustRevalidateAuthorizationBeforeReplay": true,
    "gapBehavior": "explicit-reset-snapshot",
    "rawDesktopSseForwarding": false,
    "events": {
