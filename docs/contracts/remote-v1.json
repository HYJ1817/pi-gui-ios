{
  "contractVersion": 1,
  "protocolName": "pi-gui-remote",
  "status": "design-contract",
  "transport": {
    "scheme": "https",
    "defaultEnabled": false,
    "existingLocalApiForwarding": false,
    "pairing": {
      "codeFormat": "6-digit decimal CSPRNG code; never logged or stored in plaintext",
      "ttlSeconds": 120,
      "maxAttemptsPerWindow": 5,
      "singleUse": true,
      "requiresDesktopLocalConfirmation": true,
      "defaultScopes": [
        "projects.read",
        "sessions.read"
      ],
      "attemptWindowSeconds": 600,
      "codeEntropyBits": 19.93,
      "verification": "rate limited and single use; code is shown locally and is not credential by itself; exact TLS service fingerprint plus device key possession proof and desktop confirmation required",
      "pairingSessionId": {
        "encoding": "base64url-no-padding-16-random-bytes",
        "carriedInQrAndExchangeBody": true,
        "expiresWithPairCode": true
      },
      "codeGeneration": "CSPRNG; six decimal digits; display once in trusted desktop UI and QR; never include in logs",
      "pairingCodeStorage": "HMAC-SHA256(installation-secret, pairingSessionId || pairingCode); secret created locally with restrictive file ACL; compare using constant-time equality; never persist plaintext pairing code",
      "perSessionAttemptLimit": 5,
      "maxPendingSessions": 8
    },
    "tls": {
      "minimum": "TLS 1.2",
      "desktopServiceFingerprintRequired": true,
      "redirects": "forbidden",
      "hostnameOrPinnedFingerprintMustMatch": true
    }
  },
  "signedRequestHeaders": [
    "x-pi-remote-device",
    "x-pi-remote-request-id",
    "x-pi-remote-timestamp",
    "x-pi-remote-nonce",
    "x-pi-remote-body-sha256",
    "x-pi-remote-signature"
  ],
  "requestEnvelope": {
    "type": "object",
    "required": [
      "protocolVersion",
      "operation",
      "payload"
    ],
    "additionalProperties": false,
    "properties": {
      "protocolVersion": {
        "type": "integer",
        "const": 1
      },
      "operation": {
        "type": "string",
        "enum": [
          "projects.list",
          "sessions.list",
          "runtime.create",
          "runtime.snapshot",
          "chat.send",
          "chat.stop",
          "approvals.list",
          "approvals.respond"
        ]
      },
      "ownerRevision": {
        "type": "integer",
        "minimum": 0
      },
      "payload": {
        "type": "object"
      }
    }
  },
  "pairExchange": {
    "method": "POST",
    "path": "/remote/v1/pair/exchange",
    "body": {
      "type": "object",
      "required": [
        "pairCode",
        "deviceName",
        "devicePublicKey",
        "clientNonce",
        "serviceFingerprint",
        "proofSignature",
        "pairingSessionId"
      ],
      "additionalProperties": false,
      "properties": {
        "pairCode": {
          "type": "string",
          "pattern": "^[0-9]{6}$"
        },
        "deviceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "devicePublicKey": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "clientNonce": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "serviceFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "proofSignature": {
          "type": "string",
          "minLength": 86,
          "maxLength": 86,
          "pattern": "^[A-Za-z0-9_-]{86}$"
        },
        "pairingSessionId": {
          "type": "string",
          "minLength": 22,
          "maxLength": 22,
          "pattern": "^[A-Za-z0-9_-]{22}$"
        }
      }
    },
    "authorization": "TLS peer certificate fingerprint must match the desktop QR/bootstrap fingerprint; client proves possession of device private key; desktop locally confirms device and scopes",
    "responseFields": [
      "deviceId",
      "serverNonce",
      "grantedScopes"
    ],
    "defaultScopes": [
      "projects.read",
      "sessions.read"
    ],
    "publicKeyAlgorithm": "Ed25519-raw-public-key",
    "responseSchema": {
      "type": "object",
      "required": [
        "deviceId",
        "serverNonce",
        "grantedScopes",
        "expiresAt",
        "serverSignature"
      ],
      "additionalProperties": false,
      "properties": {
        "deviceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        },
        "serverNonce": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "grantedScopes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "projects.read",
              "sessions.read",
              "sessions.create",
              "approvals.read",
              "chat.send",
              "chat.stop",
              "approvals.respond"
            ]
          }
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "serverSignature": {
          "type": "string",
          "minLength": 86,
          "maxLength": 86,
          "pattern": "^[A-Za-z0-9_-]{86}$",
          "description": "Ed25519 signature over remote-v1-pair-response, clientNonce and canonical unsigned response; clientNonce from request is the correlation binding"
        }
      }
    },
    "bodyEncoding": "UTF-8 canonical JSON with sorted keys; reject duplicate keys and non-canonical bodies",
    "proofMessage": "remote-v1-pair + newline + pairingSessionId + newline + pairCode + newline + deviceName + newline + devicePublicKey + newline + clientNonce + newline + serviceFingerprint"
  },
  "responseEnvelope": {
    "successRequired": [
      "protocolVersion",
      "requestId",
      "operation",
      "serverRevision",
      "result"
    ],
    "errorRequired": [
      "protocolVersion",
      "requestId",
      "error"
    ],
    "errorFields": [
      "code",
      "retryable"
    ],
    "rawErrorMessage": false,
    "errorCodePattern": "^(?:unauthorized|pairing_required|pairing_expired|pairing_rejected|rate_limited|scope_denied|stale_owner|stale_revision|unknown_resource|operation_rejected|replay_rejected|cursor_expired|sequence_gap|server_busy|unavailable|invalid_request|payload_invalid|internal_error)$",
    "errorCodes": [
      "unauthorized",
      "pairing_required",
      "pairing_expired",
      "pairing_rejected",
      "rate_limited",
      "scope_denied",
      "stale_owner",
      "stale_revision",
      "unknown_resource",
      "operation_rejected",
      "replay_rejected",
      "cursor_expired",
      "sequence_gap",
      "server_busy",
      "unavailable",
      "invalid_request",
      "payload_invalid",
      "internal_error"
    ]
  },
  "scopeVocabulary": [
    "projects.read",
    "sessions.read",
    "sessions.create",
    "approvals.read",
    "chat.send",
    "chat.stop",
    "approvals.respond"
  ],
  "operations": [
    {
