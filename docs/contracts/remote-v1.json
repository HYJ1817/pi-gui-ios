        "sequence",
        "conversationId",
        "ownerRevision",
        "event",
        "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "const": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "conversationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        },
        "event": {
          "type": "string",
          "enum": [
            "snapshot",
            "message.append",
            "conversation.status",
            "approval.pending",
            "approval.settled",
            "reset"
          ]
        },
        "payload": {
          "type": "object"
        },
        "ownerRevision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
