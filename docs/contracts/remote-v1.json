  "forbiddenCapabilities": [
    "generic-rpc",
    "shell",
    "terminal",
    "filesystem",
    "arbitrary-path",
    "provider-credentials",
    "raw-desktop-token",
    "arbitrary-url-proxy",
    "public-relay"
  ],
  "securityInvariants": [
    "remote-default-disabled",
    "separate-listener-and-authentication-boundary",
    "server-resolves-project-and-session-ownership",
    "device-revocation-closes-live-stream-and-rejects-new-requests",
    "unknown-version-operation-field-owner-or-replay-state-fails-closed",
    "no-raw-pi-rpc-sse-errors-config-or-credentials-in-mobile-projection",
    "approval-is-only-a-single-response-to-a-live-pi-request",
    "independent-security-review-before-enable-or-acceptance"
  ],
  "signedRequest": {
    "algorithm": "Ed25519",
    "devicePublicKeyEncoding": "base64url-no-padding-32-byte-key",
    "timestampFormat": "unix-milliseconds-decimal",
    "maximumClockSkewSeconds": 60,
    "nonceEncoding": "base64url-no-padding-32-random-bytes",
    "signatureEncoding": "base64url-no-padding-64-byte-signature",
    "bodyDigest": "SHA-256 over exact canonical UTF-8 JSON body bytes; GET signs empty body",
    "contentType": "application/json; charset=utf-8",
    "bodyEncoding": "UTF-8 canonical JSON: lexicographically sorted object keys, compact separators, JSON escaping, array order preserved; reject duplicate keys and non-canonical bodies",
    "signedMessage": "protocolVersion + newline + requestId + newline + method + newline + canonical path-and-query + newline + timestamp + newline + nonce + newline + lowercase-hex-body-sha256",
    "replayStore": "atomic per-device nonce store; reject reused nonce and timestamp outside skew window",
