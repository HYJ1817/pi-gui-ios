    "nonceRetentionSeconds": 120,
    "rawPayloadExposedToErrorsOrLogs": false
  },
  "limits": {
    "maxRequestBytes": 262144,
    "maxResponseBytes": 1048576,
    "maxOperationsPerMinutePerDevice": 120,
    "maxConcurrentStreamsPerDevice": 2,
